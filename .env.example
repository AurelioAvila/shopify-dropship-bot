# Shopify Custom App (Dev Dashboard -> Dropship Bot -> Impostazioni -> Credenziali)
# Il token si autogenera ad ogni esecuzione con client_id+secret (scade ogni 24h, gestito dal codice)
SHOPIFY_STORE_DOMAIN=tuonegozio.myshopify.com
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10

# CJdropshipping: https://www.cjdropshipping.com/my.html#/authorize/API -> tab API -> Add API -> tipo "API Key"
CJ_API_KEY=CJUserNum@api@xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pricing
MARKUP_PERCENT=45
MIN_MARGIN_EUR=5

# TikTok - un set di credenziali per brand (genera con get_tiktok_token.py NOME_BRAND)
TIKTOK_GROOMLYCO_CLIENT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TIKTOK_GROOMLYCO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TIKTOK_GROOMLYCO_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TIKTOK_MAGDOCK_CLIENT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TIKTOK_MAGDOCK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TIKTOK_MAGDOCK_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Instagram (Meta for Developers) - un set di credenziali per brand
INSTAGRAM_GROOMLYCO_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INSTAGRAM_GROOMLYCO_IG_USER_ID=178414418158740xx
INSTAGRAM_MAGDOCK_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INSTAGRAM_MAGDOCK_IG_USER_ID=178414399181592xx
